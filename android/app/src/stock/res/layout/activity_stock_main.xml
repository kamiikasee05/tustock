<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar: take start + config -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/startTakeButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Iniciar toma"
            android:textStyle="bold"
            android:backgroundTint="#22c55e"
            android:textColor="#ffffff"
            android:paddingHorizontal="16dp" />

        <Switch
            android:id="@+id/auditToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:thumbTint="#4d8eff"
            android:trackTint="#334155" />

        <TextView
            android:id="@+id/auditLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auditoría"
            android:textColor="#94a3b8"
            android:textSize="13sp"
            android:layout_marginStart="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/configButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="⚙"
            android:textSize="16sp"
            android:backgroundTint="#334155"
            android:textColor="#94a3b8"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Session bar: active take info + actions -->
    <LinearLayout
        android:id="@+id/sessionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:layout_marginTop="60dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#CC0f172a"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/sessionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Líneas: 0 · Productos: 0"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sessionCsvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/shareButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Finalizar y enviar"
                android:textStyle="bold"
                android:backgroundTint="#4d8eff"
                android:textColor="#ffffff"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/newTakeButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Nueva toma"
                android:backgroundTint="#334155"
                android:textColor="#e2e8f0" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/scanHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escanee un codigo para registrar stock"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#99000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" />

    <!-- Product found card -->
    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1e293b"
        android:padding="20dp"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <TextView
            android:id="@+id/productNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/productCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/productPriceText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#22c55e"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/productStockText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#e2e8f0"
                android:textSize="16sp"
                android:gravity="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/auditCompareText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94a3b8"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/newProductNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del producto (nuevo)"
            android:textColor="#e2e8f0"
            android:textColorHint="#475569"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:inputType="text"
            android:visibility="gone" />

        <EditText
            android:id="@+id/newPriceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio ($)"
            android:textColor="#e2e8f0"
            android:textColorHint="#475569"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:inputType="numberDecimal"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/quantityInput"
                android:layout_width="80dp"
                android:layout_height="42dp"
                android:hint="Cant."
                android:textColor="#e2e8f0"
                android:textColorHint="#475569"
                android:background="@drawable/edit_text_bg"
                android:inputType="number"
                android:padding="8dp"
                android:text="1"
                android:textAlignment="center" />

            <Button
                android:id="@+id/addStockButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Agregar al stock"
                android:textStyle="bold"
                android:backgroundTint="#22c55e"
                android:textColor="#ffffff"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/scanAgainButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Otro"
                android:backgroundTint="#334155"
                android:textColor="#e2e8f0"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/registerProductButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Registrar en el sistema"
            android:textStyle="bold"
            android:backgroundTint="#f59e0b"
            android:textColor="#ffffff"
            android:layout_marginTop="10dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Product not found card -->
    <LinearLayout
        android:id="@+id/notFoundCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1e293b"
        android:padding="20dp"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Producto no encontrado"
            android:textColor="#f59e0b"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notFoundCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94a3b8"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/registerNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del producto"
            android:textColor="#e2e8f0"
            android:textColorHint="#475569"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <EditText
                android:id="@+id/registerPriceInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Precio $"
                android:textColor="#e2e8f0"
                android:textColorHint="#475569"
                android:background="@drawable/edit_text_bg"
                android:padding="12dp"
                android:inputType="numberDecimal"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/registerQuantityInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Cantidad"
                android:textColor="#e2e8f0"
                android:textColorHint="#475569"
                android:background="@drawable/edit_text_bg"
                android:padding="12dp"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/notFoundAgainButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:backgroundTint="#334155"
                android:textColor="#e2e8f0"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/registerSubmitButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="2"
                android:text="Registrar producto"
                android:textStyle="bold"
                android:backgroundTint="#22c55e"
                android:textColor="#ffffff" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
