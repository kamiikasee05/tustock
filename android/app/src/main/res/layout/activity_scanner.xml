<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/overlayTop"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#99000000"
        android:layout_gravity="top" />

    <View
        android:id="@+id/overlayBottom"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="#99000000"
        android:layout_gravity="bottom" />

    <View
        android:layout_width="280dp"
        android:layout_height="3dp"
        android:background="#3b82f6"
        android:layout_gravity="center"
        android:layout_marginTop="-1.5dp" />

    <View
        android:layout_width="3dp"
        android:layout_height="280dp"
        android:background="#3b82f6"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/overlayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Apunte la cámara al código"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="200dp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1e293b"
        android:padding="20dp"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <TextView
            android:id="@+id/productNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/productCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/productPriceText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#22c55e"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/productStockText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#e2e8f0"
                android:textSize="16sp"
                android:gravity="end" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/scanAgainButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Escanear otro"
                android:backgroundTint="#334155"
                android:textColor="#e2e8f0"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/registerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Registrar"
                android:backgroundTint="#3b82f6"
                android:textColor="#ffffff"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
