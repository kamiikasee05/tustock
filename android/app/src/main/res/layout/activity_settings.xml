<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0f172a">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configuración"
        android:textColor="#ffffff"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="URL del servidor"
        android:textColor="#94a3b8"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/urlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://192.168.1.100:8090"
        android:textColor="#e2e8f0"
        android:textColorHint="#475569"
        android:background="@drawable/edit_text_bg"
        android:padding="14dp"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/testButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Probar"
            android:backgroundTint="#334155"
            android:textColor="#e2e8f0"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Guardar"
            android:backgroundTint="#3b82f6"
            android:textColor="#ffffff" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/registerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar nuevo producto"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/registerCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código QR/barras"
            android:textColor="#e2e8f0"
            android:textColorHint="#475569"
            android:background="@drawable/edit_text_bg"
            android:padding="14dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/registerNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del producto"
            android:textColor="#e2e8f0"
            android:textColorHint="#475569"
            android:background="@drawable/edit_text_bg"
            android:padding="14dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/registerPriceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio de venta"
            android:textColor="#e2e8f0"
            android:textColorHint="#475569"
            android:background="@drawable/edit_text_bg"
            android:padding="14dp"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/registerSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar producto"
            android:backgroundTint="#22c55e"
            android:textColor="#ffffff"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
