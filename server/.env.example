# TUSTOCK — Variables de entorno (copiar a .env)
# El servidor NO arranca sin TUSTOCK_TOKEN configurado.

# Token de autenticación del servidor local
TUSTOCK_TOKEN=tustock-local-token

# Token del admin panel
TUSTOCK_ADMIN_TOKEN=150588-reg

# URL de la base de datos (vacío = SQLite local)
TUSTOCK_DB=

# Host y puerto del servidor
TUSTOCK_HOST=0.0.0.0
TUSTOCK_PORT=8090

# URL del cloud (Railway)
TUSTOCK_CLOUD_URL=https://tustock.up.railway.app
